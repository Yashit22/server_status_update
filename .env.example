# --- Required ---
# Comma-separated HTTPS tunnel URLs to health-check.
HEALTH_CHECK_TARGETS="https://vital.connectgenai.in,https://molaris-dms.jaytelecom.online/"

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY="re_D7YhxrFH_LTbruCeUq3ywhpX2ww5jiVEf"

# Verified Resend sender. Must be a domain/address verified in your Resend account.
ALERT_FROM="Server Monitor <moniton@jaytelecom.online>"

# --- Optional (defaults shown) ---
# Recipients. If unset, defaults to the three project IDs in lib/config.ts.
ALERT_TO="connectgenai@gmail.com,yashit.foruppo@gmail.com,avtanshg919@gmail.com"

# Retry attempts after the first failure, and delay between them.
# NOTE (Vercel Hobby): the function is capped at maxDuration 60s (set in
# vercel.json). Targets are checked concurrently, so the worst-case runtime is
# ONE target's full retry chain:
#   (HEALTH_RETRIES + 1) * HEALTH_TIMEOUT_MS  +  HEALTH_RETRIES * HEALTH_RETRY_DELAY_MS
# Keep that under ~50s to leave room for cold start + sending the email.
# Defaults below = (4+1)*5000 + 4*1000 = 29s worst case. Safe on Hobby.
HEALTH_RETRIES="4"
HEALTH_RETRY_DELAY_MS="1000"

# Per-request timeout.
HEALTH_TIMEOUT_MS="5000"

# Shared secret that authenticates the external scheduler (cron-job.org).
# Set the SAME value here (in Vercel env) and in the cron-job.org job's
# "Authorization: Bearer <value>" header. Generate one with: openssl rand -hex 32
# If unset, the endpoint accepts unauthenticated requests (not recommended).
HEALTH_CHECK_SECRET="hello,are_you_ok?"
