# --- Required ---
# Comma-separated HTTPS tunnel URLs to health-check.
HEALTH_CHECK_TARGETS="https://process-one.example.com/health,https://process-two.example.com/"

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# Verified Resend sender. Must be a domain/address verified in your Resend account.
ALERT_FROM="Server Monitor <alerts@yourdomain.com>"

# --- Optional (defaults shown) ---
# Recipients. If unset, defaults to the three project IDs in lib/config.ts.
ALERT_TO="connectgenai@gmail.com,yashit.foruppo@gmail.com,avtanshg919@gmail.com"

# Retry attempts after the first failure, and delay between them.
HEALTH_RETRIES="5"
HEALTH_RETRY_DELAY_MS="1000"

# Per-request timeout.
HEALTH_TIMEOUT_MS="8000"

# Shared secret that authenticates the external scheduler (cron-job.org).
# Set the SAME value here (in Vercel env) and in the cron-job.org job's
# "Authorization: Bearer <value>" header. Generate one with: openssl rand -hex 32
# If unset, the endpoint accepts unauthenticated requests (not recommended).
HEALTH_CHECK_SECRET="change-me-to-a-long-random-string"
